{
  "schemaVersion": 1,
  "id": "villageskins",
  "version": "${version}",
  "name": "村民换肤",
  "description": "给每位村民选择本地 PNG 玩家皮肤，支持普通与 Alex 细手臂、交易页入口和蹲下右键换肤。仅客户端显示。",
  "environment": "client",
  "entrypoints": {
    "client": ["villageskins.VillagerSkinsClient"]
  },
  "mixins": [
    {
      "config": "villageskins.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
